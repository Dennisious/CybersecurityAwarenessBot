<Window x:Class="CybersecurityAwarenessBot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuard | Cybersecurity Awareness Assistant"
        Height="800" Width="1100"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Foreground="#F1F5F9">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111C2E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style x:Key="TopicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#DCE7F5"/>
            <Setter Property="BorderBrush" Value="#2A3B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="QuizOptionStyle" TargetType="Button">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2A3B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1626"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2A3B52"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,18"
                BorderBrush="#24344A"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="210" Height="100"
                        Background="#0C1626"
                        CornerRadius="10"
                        BorderBrush="#24344A"
                        BorderThickness="1"
                        Padding="8">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="AsciiLogoText"
                                   FontFamily="Consolas"
                                   FontSize="8"
                                   Foreground="#2DD4BF"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   Text="CYBERGUARD"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="CYBERGUARD"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>

                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Learn • Protect • Stay Safe"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,9,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="●  ASSISTANT READY"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Your safety starts with awareness."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="160"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN NAVIGATION -->
        <TabControl Grid.Row="1"
                    Background="#111C2E"
                    Foreground="#F1F5F9"
                    BorderBrush="#24344A"
                    Padding="8">

            <!-- CHAT TAB -->
            <TabItem Header="💬 Chat">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Your conversation"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Ask questions and learn how to stay safe online."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#0C1626"
                            CornerRadius="12"
                            BorderBrush="#223148"
                            BorderThickness="1"
                            Padding="16">

                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto">

                            <StackPanel x:Name="ChatPanel">
                                <Border Background="#153A42"
                                        CornerRadius="10"
                                        Padding="14"
                                        HorizontalAlignment="Left"
                                        MaxWidth="680"
                                        Margin="0,0,0,12">

                                    <StackPanel>
                                        <TextBlock Text="CYBERGUARD"
                                                   Foreground="#5EEAD4"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="Welcome to CyberGuard! I'm here to help you understand cybersecurity in a simple, practical way. Ask me about passwords, scams, phishing, privacy, and more."
                                                   TextWrapping="Wrap"
                                                   Foreground="#E2E8F0"
                                                   FontSize="13"
                                                   LineHeight="21"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="EXPLORE A TOPIC"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,8"/>

                        <WrapPanel>
                            <Button x:Name="PasswordTopicButton"
                                    Content="🔑 Password Safety"
                                    Style="{StaticResource TopicButtonStyle}"/>

                            <Button x:Name="PhishingTopicButton"
                                    Content="🎣 Phishing"
                                    Style="{StaticResource TopicButtonStyle}"/>

                            <Button x:Name="ScamsTopicButton"
                                    Content="🚨 Online Scams"
                                    Style="{StaticResource TopicButtonStyle}"/>

                            <Button x:Name="PrivacyTopicButton"
                                    Content="🔒 Privacy"
                                    Style="{StaticResource TopicButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageInput"
                                 Grid.Column="0"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Type your cybersecurity question here"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send ➤"
                                Style="{StaticResource ActionButtonStyle}"
                                Padding="24,12"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TASKS TAB -->
            <TabItem Header="📋 My Tasks">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <TextBlock Text="Cybersecurity Task Assistant"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Create and manage your cybersecurity tasks and reminders."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="Task title" FontWeight="SemiBold"/>

                        <TextBox x:Name="TaskTitleInput"
                                 MaxLength="150"
                                 ToolTip="Enter your task title"/>

                        <TextBlock Text="Task description" FontWeight="SemiBold"/>

                        <TextBox x:Name="TaskDescriptionInput"
                                 Height="75"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Describe what you need to do"/>

                        <TextBlock Text="Reminder date (optional)"
                                   FontWeight="SemiBold"/>

                        <DatePicker x:Name="ReminderDatePicker"
                                    Margin="0,5,0,12"
                                    Background="#0C1626"
                                    Foreground="#111827"/>

                        <TextBlock Text="Reminder time (optional, HH:mm)"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ReminderTimeInput"
                                 Text="09:00"
                                 ToolTip="Example: 09:00"/>

                        <WrapPanel Margin="0,5,0,20">
                            <Button x:Name="AddTaskButton"
                                    Content="➕ Add Task"
                                    Style="{StaticResource ActionButtonStyle}"/>

                            <Button x:Name="RefreshTasksButton"
                                    Content="↻ Refresh Tasks"
                                    Style="{StaticResource TopicButtonStyle}"/>
                        </WrapPanel>

                        <TextBlock Text="YOUR SAVED TASKS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="TasksDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="#0C1626"
                                  Foreground="#111827"
                                  RowBackground="#E2E8F0"
                                  AlternatingRowBackground="#CBD5E1"
                                  BorderBrush="#24344A"
                                  MinHeight="200">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding TaskID}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Title"
                                                    Binding="{Binding Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Reminder"
                                                    Binding="{Binding ReminderAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                                    Width="150"/>

                                <DataGridCheckBoxColumn Header="Completed"
                                                        Binding="{Binding IsCompleted}"
                                                        Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,15,0,10">
                            <Button x:Name="CompleteTaskButton"
                                    Content="✓ Mark Completed"
                                    Style="{StaticResource ActionButtonStyle}"/>

                            <Button x:Name="DeleteTaskButton"
                                    Content="🗑 Delete Task"
                                    Background="#B91C1C"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,9"
                                    Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- QUIZ TAB -->
            <TabItem Header="🎯 Quiz">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="25">

                        <!-- QUIZ INTRODUCTION -->
                        <StackPanel x:Name="QuizIntroPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="650">

                            <TextBlock Text="🛡️"
                                       FontSize="55"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Cybersecurity Mini-Game"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Test your knowledge and become a smarter, safer internet user."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="14"
                                       Margin="0,12,0,20"/>

                            <Border Background="#0C1626"
                                    BorderBrush="#24344A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20">

                                <StackPanel>
                                    <TextBlock Text="WHAT TO EXPECT"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="• 15 cybersecurity questions"
                                               Margin="0,4"/>

                                    <TextBlock Text="• Multiple-choice and True/False questions"
                                               Margin="0,4"/>

                                    <TextBlock Text="• Instant feedback and explanations"
                                               Margin="0,4"/>

                                    <TextBlock Text="• Score tracking and final results"
                                               Margin="0,4"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="StartQuizButton"
                                    Content="Start Quiz ➜"
                                    Style="{StaticResource ActionButtonStyle}"
                                    FontSize="15"
                                    Padding="30,14"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- QUESTION PANEL -->
                        <StackPanel x:Name="QuizQuestionPanel"
                                    Visibility="Collapsed"
                                    MaxWidth="750"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="CYBERGUARD KNOWLEDGE CHALLENGE"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="QuizProgressText"
                                           Text="Question 1 of 15"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="QuizScoreText"
                                           Grid.Column="1"
                                           Text="Score: 0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"/>
                            </Grid>

                            <ProgressBar x:Name="QuizProgressBar"
                                         Minimum="0"
                                         Maximum="15"
                                         Value="0"
                                         Height="8"
                                         Background="#24344A"
                                         Foreground="#2DD4BF"
                                         Margin="0,0,0,25"/>

                            <Border Background="#0C1626"
                                    BorderBrush="#24344A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24">

                                <StackPanel>
                                    <TextBlock x:Name="QuizQuestionTypeText"
                                               Text="MULTIPLE CHOICE"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>

                                    <TextBlock x:Name="QuizQuestionText"
                                               Text="Question appears here."
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,25"/>

                                    <StackPanel x:Name="QuizOptionsPanel">

                                        <Button x:Name="QuizOption1"
                                                Style="{StaticResource QuizOptionStyle}"/>

                                        <Button x:Name="QuizOption2"
                                                Style="{StaticResource QuizOptionStyle}"/>

                                        <Button x:Name="QuizOption3"
                                                Style="{StaticResource QuizOptionStyle}"/>

                                        <Button x:Name="QuizOption4"
                                                Style="{StaticResource QuizOptionStyle}"/>
                                    </StackPanel>

                                    <Border x:Name="QuizFeedbackBorder"
                                            Background="#153A42"
                                            CornerRadius="8"
                                            Padding="15"
                                            Margin="0,10,0,15"
                                            Visibility="Collapsed">

                                        <TextBlock x:Name="QuizFeedbackText"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="#E2E8F0"/>
                                    </Border>

                                    <Button x:Name="NextQuestionButton"
                                            Content="Next Question ➜"
                                            Style="{StaticResource ActionButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Padding="22,12"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RESULTS PANEL -->
                        <StackPanel x:Name="QuizResultPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="650">

                            <TextBlock Text="🏆"
                                       FontSize="55"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Quiz Completed!"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>

                            <TextBlock x:Name="QuizFinalScoreText"
                                       Text="Your score: 0 out of 15"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,20,0,10"/>

                            <TextBlock x:Name="QuizFinalMessageText"
                                       Text="Well done!"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,25"/>

                            <Button x:Name="RestartQuizButton"
                                    Content="↻ Play Again"
                                    Style="{StaticResource ActionButtonStyle}"
                                    FontSize="15"
                                    Padding="25,13"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ACTIVITY LOG TAB -->
            <TabItem Header="📊 Activity Log">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CyberGuard Activity Log"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Review the actions performed during your session."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,15"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ActivityLogCountText"
                                   Text="Showing your 10 most recent activities"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="ActivityLogStatusText"
                                   Grid.Column="1"
                                   Text="SESSION ACTIVITY"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#0C1626"
                            BorderBrush="#24344A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">

                        <Grid>
                            <TextBlock x:Name="ActivityLogEmptyText"
                                       Text="No activity has been recorded yet. Start chatting, add a task or play the quiz to see your activity here."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="450"
                                       Margin="20"/>

                            <ListView x:Name="ActivityLogList"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#F1F5F9"
                                      Visibility="Visible"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Date &amp; Time"
                                                        DisplayMemberBinding="{Binding Timestamp}"
                                                        Width="155"/>

                                        <GridViewColumn Header="Action"
                                                        DisplayMemberBinding="{Binding Action}"
                                                        Width="170"/>

                                        <GridViewColumn Header="Details"
                                                        DisplayMemberBinding="{Binding Details}"
                                                        Width="430"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <Button x:Name="ShowMoreActivityButton"
                            Grid.Row="3"
                            Content="Show More Activities"
                            Style="{StaticResource TopicButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0"
                            Visibility="Collapsed"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
