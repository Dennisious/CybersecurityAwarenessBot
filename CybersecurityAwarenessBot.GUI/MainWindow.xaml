<Window x:Class="CybersecurityAwarenessBot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuard | Cybersecurity Awareness Assistant"
        Height="800"
        Width="1100"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Foreground="#F1F5F9">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111C2E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style x:Key="TopicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#DCE7F5"/>
            <Setter Property="BorderBrush" Value="#2A3B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CyberGuard header -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,18"
                BorderBrush="#24344A"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Original ASCII logo loaded from the Media folder -->
                <Border Width="210"
                        Height="120"
                        Background="#0C1626"
                        CornerRadius="10"
                        BorderBrush="#24344A"
                        BorderThickness="1"
                        Padding="8"
                        VerticalAlignment="Center">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">

                        <TextBlock x:Name="AsciiLogoText"
                                   FontFamily="Consolas"
                                   FontSize="8"
                                   Foreground="#2DD4BF"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   Text="CYBERGUARD"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="CYBERGUARD"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>

                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Learn • Protect • Stay Safe"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,9,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="●  ASSISTANT READY"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="Your safety starts with awareness."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               MaxWidth="160"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main conversation panel -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16"
                Padding="22"
                BorderBrush="#24344A"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Your conversation"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"/>

                    <TextBlock Text="Ask questions, explore topics, and learn how to stay safe online."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Chat messages -->
                <Border Grid.Row="1"
                        Background="#0C1626"
                        CornerRadius="12"
                        BorderBrush="#223148"
                        BorderThickness="1"
                        Padding="16">

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="ChatPanel">
                            <Border Background="#153A42"
                                    CornerRadius="10"
                                    Padding="14"
                                    HorizontalAlignment="Left"
                                    MaxWidth="680"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <TextBlock Text="CYBERGUARD"
                                               Foreground="#5EEAD4"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="Welcome to CyberGuard! I'm here to help you understand cybersecurity in a simple, practical way. You can ask me about passwords, scams, phishing, privacy, and more. What would you like to learn today?"
                                               TextWrapping="Wrap"
                                               Foreground="#E2E8F0"
                                               FontSize="13"
                                               LineHeight="21"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Suggested cybersecurity topics -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="EXPLORE A TOPIC"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,9"/>

                    <WrapPanel>
                        <Button x:Name="PasswordTopicButton"
                                Content="🔑 Password Safety"
                                Style="{StaticResource TopicButtonStyle}"/>

                        <Button x:Name="PhishingTopicButton"
                                Content="🎣 Phishing"
                                Style="{StaticResource TopicButtonStyle}"/>

                        <Button x:Name="ScamsTopicButton"
                                Content="🚨 Online Scams"
                                Style="{StaticResource TopicButtonStyle}"/>

                        <Button x:Name="PrivacyTopicButton"
                                Content="🔒 Privacy"
                                Style="{StaticResource TopicButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- User message input -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14"
                Padding="12"
                Margin="0,18,0,0"
                BorderBrush="#24344A"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Background="Transparent"
                         Foreground="#F8FAFC"
                         CaretBrush="#2DD4BF"
                         BorderThickness="0"
                         FontSize="13"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         ToolTip="Type your cybersecurity question here"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send  ➤"
                        Background="#0D9488"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="24,12"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
